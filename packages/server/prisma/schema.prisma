generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Channel {
  id                String    @id @default(cuid())
  handle            String?   @unique
  title             String
  language          String
  uploadsPlaylistId String
  lastSyncedAt      DateTime?
  videos            Video[]

  @@map("channels")
}

model FairyTale {
  id             String        @id @default(cuid())
  slug           String        @unique
  canonicalTitle String
  thumbnailUrl   String
  translations   Translation[]
  videos         Video[]

  @@map("fairy_tales")
}

model Translation {
  id          String    @id @default(cuid())
  fairyTaleId String
  language    String
  title       String
  fairyTale   FairyTale @relation(fields: [fairyTaleId], references: [id], onDelete: Cascade)

  @@unique([fairyTaleId, language])
  @@map("translations")
}

model Video {
  id              String     @id @default(cuid())
  youtubeId       String     @unique
  channelId       String
  fairyTaleId     String?
  title           String
  cleanTitle      String
  publishedAt     DateTime
  durationSeconds Int?
  thumbnailUrl    String?
  embeddable      Boolean?
  rawPayload      Json?
  channel         Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fairyTale       FairyTale? @relation(fields: [fairyTaleId], references: [id], onDelete: SetNull)

  @@map("videos")
}
